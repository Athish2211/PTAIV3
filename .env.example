# ─────────────────────────────────────────────────────────────────
# PTAI v3 — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────
APP_ENV=development
APP_NAME="PTAI v3"
APP_VERSION=3.0.0

# ── Database ──────────────────────────────────────────────────────
POSTGRES_DB=ptai_db
POSTGRES_USER=ptai_user
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://ptai_user:change-me-in-production@localhost:5432/ptai_db
DATABASE_SYNC_URL=postgresql://ptai_user:change-me-in-production@localhost:5432/ptai_db

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-in-production-redis
REDIS_URL=redis://:change-me-in-production-redis@localhost:6379/0

# ── Security ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-in-production-refresh-secret-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET=change-me-in-production-session-secret
MFA_ENCRYPTION_KEY=change-me-in-production-mfa-encryption-key

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── AI / Ollama ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=ollama

# Primary language model (balance of speed and quality)
LLM_MODEL=llama3.2:3b

# Fast model for simple tasks (summarization, navigation)
FAST_MODEL=llama3.2:3b

# Quality model for complex multi-agent synthesis
QUALITY_MODEL=llama3.1:8b

# Embedding model for RAG
EMBEDDING_MODEL=nomic-embed-text

# Vector dimensions (must match embedding model)
VECTOR_DIMENSION=768

# LLM timeouts
LLM_TIMEOUT_SECONDS=60
STREAMING_TIMEOUT_SECONDS=120

# ── File Upload ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
MAX_DATASET_MB=100
ALLOWED_DOCUMENT_TYPES=pdf,docx,doc,txt,png,jpg,jpeg
ALLOWED_DATASET_TYPES=csv,xlsx,xls,json

# ── Analytics ─────────────────────────────────────────────────────
ANALYTICS_MIN_RECORDS=10
ANALYTICS_CACHE_HOURS=24

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="PTAI v3"
NEXT_PUBLIC_APP_TAGLINE="AI-native EHR that remembers, analyzes and surfaces clinical patterns"

# ── Git Auto-Sync ─────────────────────────────────────────────────
# Optional: GitHub Personal Access Token (PAT) for authenticated git push inside Docker.
# Public pulls work automatically without a token.
GITHUB_TOKEN=
GIT_BRANCH=master
SYNC_INTERVAL=15

